{
  "name": "alto-security-tests",
  "private": true,
  "description": "Firestore/Storage rules and share viewer tests, run against the Firebase emulator only.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage,auth --project demo-alto-security \"node --test --test-concurrency=1 *.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.35.1",
    "playwright": "1.63.0"
  }
}
